# Ignore heavy package folders
node_modules/
.npm-cache/

# Ignore local compiled static web directories
dist/
__pycache__/
*.py[cod]
data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.sqlite
*.sqlite-journal
*.db
*.db-*

# Local Ansible workspace contents generated during development/deployment
/ansible-workspace/

# Ignore binary container image packages and snapshots
*.tar
*.tar.gz

# Plaintext cluster pull secret. The build vaults it into pull-secret.vault,
# which is committed. The vault password is not in this repository.
pull-secret.json

# API bearer token if one is created inside the checkout. The deploy writes
# /var/lib/ocp-metal-ui/api.token instead.
api.token

# Ignore local editor swap notes and compiler footprints
*~
.*~
.DS_Store
.vite/

# Ignore dependency installation log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local system execution logs
*.log
