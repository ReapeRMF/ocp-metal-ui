# Ignore heavy package folders
node_modules/
.npm-cache/

# Ignore local compiled static web directories
dist/
__pycache__/
*.py[cod]
data/

# Local Ansible workspace contents generated during development/deployment
/ansible-workspace/

# Ignore binary container image packages and snapshots
*.tar
*.tar.gz

# Host pull secret. It is not built into the image.
pull-secret.json
pull-secret.vault
# Do not keep a vault password in the checkout.
vault.password

# The admin token belongs outside the checkout, at
# /var/lib/ocp-metal-ui/api.token.
api.token

# Ignore local editor swap notes and compiler footprints
*~
.*~
.DS_Store
.vite/

# Ignore dependency installation log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local system execution logs
*.log
