# Ignore heavy package folders
node_modules/
.npm-cache/

# Ignore local compiled static web directories
dist/
__pycache__/
*.py[cod]
data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.sqlite
*.sqlite-journal
*.db
*.db-*

# Local Ansible workspace contents generated during development/deployment
/ansible-workspace/

# Ignore binary container image packages and snapshots
*.tar
*.tar.gz

# Cluster pull secret supplied at image build, and the vault file the build
# writes from it. Neither is committed. The image contains only the vault file.
pull-secret.json
pull-secret.vault

# Ignore local editor swap notes and compiler footprints
*~
.*~
.DS_Store
.vite/

# Ignore dependency installation log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local system execution logs
*.log
