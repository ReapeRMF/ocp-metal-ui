# python:3.13-alpine manifest list, 2026-11-19
FROM docker.io/library/python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=3003

WORKDIR /app

# openssh-keygen tracks python:3.13-alpine. An exact apk pin breaks when that tag is rebuilt.
# hadolint ignore=DL3018
RUN apk add --no-cache openssh-keygen \
    && addgroup -S -g 10001 app \
    && adduser -S -D -H -u 10001 -G app app \
    && mkdir -p /data /ansible \
    && chown 10001:10001 /data /ansible

RUN pip install --no-cache-dir "psycopg[binary]==3.3.8"

COPY --chown=10001:10001 server.py /app/server.py
COPY --chown=10001:10001 agent_install.py /app/agent_install.py
COPY --chown=10001:10001 dist/ /app/dist/

VOLUME ["/data", "/ansible"]
EXPOSE 3003
USER 10001:10001

CMD ["python3", "/app/server.py"]
